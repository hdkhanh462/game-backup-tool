{
  "name": "game-backup-tool",
  "version": "0.1.4",
  "description": "Manual game save backup & restore tool with Google Drive",
  "main": "./out/main/index.js",
  "author": "Hoàng Dương Khánh",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "yarn typecheck:node && yarn typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "start": "electron-vite preview",
    "build:win": "yarn build && electron-builder --win --publish never",
    "build:mac": "yarn build && electron-builder --mac --publish never",
    "build:linux": "yarn build && electron-builder --linux --publish never"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.103.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "electron-store": "^11.0.2",
    "google-auth-library": "^11.0.2",
    "i18next": "^26.4.2",
    "lucide-react": "^1.46.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.88.0",
    "react-i18next": "^17.0.14",
    "shadcn": "^4.21.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.0.14",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-only-warn": "^1.2.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.0.14",
    "tw-animate-css": "^1.2.5",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.2"
  }
}
