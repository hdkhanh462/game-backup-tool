# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# Do not commit it (already in .gitignore).
#
# The `MAIN_VITE_` prefix is electron-vite's convention for build-time variables
# injected into the main process's `import.meta.env` (see src/main/auth.ts and
# src/main/env.d.ts) — this file is only needed for local `yarn dev`/`yarn build`.
# For packaged releases built in CI, these are provided via GitHub Actions
# variables/secrets instead (see .github/workflows/release.yml) and baked into the
# bundle at build time, so end users installing the binary don't need a `.env` file.

# ─────────────────────────── OAuth (Google) ───────────────────────────
# [REQUIRED] From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Client ID (type "Desktop app"). The app completes the flow via a loopback redirect
# (http://127.0.0.1:<random-port>/oauth2callback) opened in the system browser — see
# src/main/auth.ts — so no fixed redirect URI needs to be registered in the console.
MAIN_VITE_GOOGLE_OAUTH_CLIENT_ID=
MAIN_VITE_GOOGLE_OAUTH_CLIENT_SECRET=
