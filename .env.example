# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# Do not commit it (already in .gitignore).
#
# Loaded explicitly at main-process startup via `dotenv` (see src/main/index.ts) —
# electron-vite does NOT inject plain .env values into process.env on its own; it only
# handles VITE_/MAIN_VITE_/PRELOAD_VITE_-prefixed build-time variables.

# ─────────────────────────── OAuth (Google) ───────────────────────────
# [REQUIRED] From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
# Client ID (type "Desktop app"). The app completes the flow via a loopback redirect
# (http://127.0.0.1:<random-port>/oauth2callback) opened in the system browser — see
# src/main/auth.ts — so no fixed redirect URI needs to be registered in the console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
